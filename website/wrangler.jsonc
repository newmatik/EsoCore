// www.esocore.com on Cloudflare Workers static assets (Newmatik account only).
// Build first: `pnpm generate` writes .output/public.
//
// Routes, not custom domains. Cloudflare refuses to attach a Workers custom domain while the
// hostname has DNS records (error 100117, with or without override_existing_dns_record), and
// deleting the GitHub Pages records first would leave the site without DNS for a moment. A
// route takes over on the existing proxied records at once: the Worker answers every request
// for both hostnames and never fetches the origin, so the A/CNAME records that still name
// GitHub Pages are only there to keep the hostnames proxied. Do not delete them while these
// routes exist; to move to custom domains later, delete them and attach the domains together.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esocore-website",
  "account_id": "24c549e9c3005de7a3c295ead2c4bb87",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "workers_dev": false,
  "routes": [
    { "pattern": "www.esocore.com/*", "zone_name": "esocore.com" },
    { "pattern": "esocore.com/*", "zone_name": "esocore.com" },
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "observability": { "enabled": true },
}
